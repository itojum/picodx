{
  "name": "picodx",
  "version": "2.1.0",
  "description": "A minimal 2D game library for PicoRuby.wasm, modelled after DXRuby's API",
  "main": "lib/picodx.rb",
  "bin": {
    "picodx": "bin/picodx"
  },
  "files": [
    "lib/picodx.rb",
    "bin/picodx",
    "cli/bundler.rb"
  ],
  "scripts": {
    "build": "ruby script/build",
    "test": "ruby test/bundler_test.rb",
    "prepublishOnly": "npm run build",
    "setup": "npm install",
    "serve": "npm run build && ruby script/server"
  },
  "keywords": [
    "picoruby",
    "picoruby-wasm",
    "ruby"
  ],
  "author": "itojum <tech@itojum.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itojum/picodx.git"
  },
  "devDependencies": {
    "@picoruby/wasm-wasi": "^4.0.2"
  },
  "engines": {
    "node": ">=26.1.0"
  }
}
