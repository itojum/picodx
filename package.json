{
  "name": "picodx",
  "version": "0.1.0",
  "description": "A minimal PicoRuby.wasm gem template",
  "main": "lib/picodx.rb",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "ruby script/build",
    "prepublishOnly": "npm run build",
    "setup": "npm install && npx playwright install chromium && bundle install",
    "test": "bundle exec rspec spec/picodx/",
    "test:e2e": "npm run build && bundle exec rspec spec/e2e/",
    "serve": "npm run build && npx serve . -l 3000"
  },
  "keywords": [
    "picoruby",
    "picoruby-wasm",
    "ruby"
  ],
  "author": "itojum <tech@itojum.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itojum/picodx.git"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  },
  "engines": {
    "node": ">=26.1.0"
  }
}
